// Keybindings 
// https://github.com/niri-wm/niri/wiki

binds {

        // Applications
        Alt+T                                                      { spawn "foot"; }
        Alt+Space                                                  { spawn "nc" "-U" "/run/user/1000/walker/walker.sock"; }
        Mod+F1                                                     { spawn "swaync-client" "-t" "-sw"; }
        Mod+F2                                                     { spawn "swaync-client" "-d" "-sw"; }
        Mod+B                                                      { spawn "librewolf"; }
        XF86Back                                                   { spawn "librewolf"; }
        XF86Forward                                                { spawn "lutris"; }
        Cancel                                                     { spawn "materialgram"; }
        XF86Reload                                                 { spawn "steam"; }


        Mod+E {spawn "nautilus"; }

        Mod+P {spawn "/home/saya/.local/bin/pavucontrol-dark"; } // Just dark pavucontrol

         // Media Controls 
         XF86AudioRaiseVolume                allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
         XF86AudioLowerVolume                allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
         XF86AudioMute                       allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

         // Window controls 
         Mod+Q { close-window; }

         Alt+A                                                     { focus-column-left; }
         Alt+S                                                     { focus-column-right; }
         Alt+Z                                                     { focus-workspace-down; }
         Alt+X                                                     { focus-workspace-up; }

         Alt+Shift+A                                                { move-column-left; }
         Alt+Shift+S                                                { move-column-right; }
         Alt+Shift+Z                                                { move-window-down-or-to-workspace-down; }
         Alt+Shift+X                                                { move-window-up-or-to-workspace-up; }

         // Control Workspaces from numbers 
         Alt+1                                                      { focus-workspace 1; }
         Alt+2                                                      { focus-workspace 2; }
         Alt+3                                                      { focus-workspace 3; }
         Alt+4                                                      { focus-workspace 4; }
         Alt+5                                                      { focus-workspace 5; }
         Alt+6                                                      { focus-workspace 6; }
         Alt+7                                                      { focus-workspace 7; }
         Alt+8                                                      { focus-workspace 8; }
         Alt+9                                                      { focus-workspace 9; }

         Alt+Shift+1                                                 { move-column-to-workspace 1; }
         Alt+Shift+2                                                 { move-column-to-workspace 2; }
         Alt+Shift+3                                                 { move-column-to-workspace 3; }
         Alt+Shift+4                                                 { move-column-to-workspace 4; }
         Alt+Shift+5                                                 { move-column-to-workspace 5; }
         Alt+Shift+6                                                 { move-column-to-workspace 6; }
         Alt+Shift+7                                                 { move-column-to-workspace 7; }
         Alt+Shift+8                                                 { move-column-to-workspace 8; }
         Alt+Shift+9                                                 { move-column-to-workspace 9; }
         // Other 
         Mod+Tab                                                    { focus-workspace-previous; }

         Alt+Ctrl+S                                                 { set-column-width "-10%"; }
         Alt+Ctrl+Z                                                 { set-window-height "-10%"; }
         Alt+Ctrl+A                                                 { set-column-width "+10%"; }
         Alt+Ctrl+X                                                 { set-window-height "+10%"; }
         Alt+P                                                      { spawn "wtype" "💜"; }

         // Modes
         Mod+T                                                      { toggle-window-floating; }
         Mod+R                                                      { switch-preset-column-width; }
         Mod+F                                                      { maximize-column; }
         Mod+Shift+F                                                { fullscreen-window; }
         Mod+Alt+F                                                  { toggle-windowed-fullscreen; }

         // Screenshots

         Mod+Z                                                      { screenshot; }
         Shift+Mod+Z                                                { screenshot-window; }

         // Panic
         Mod+Escape                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

         // Power 
         Ctrl+Alt+Delete                                            { quit; } // Quit session
         Mod+Shift+X                                                { power-off-monitors; } // to watch obscenities 
}
